{
  "info": {
    "name": "AOS 2026.2 — API de Tarefas",
    "_postman_id": "aos-tarefas-collection",
    "description": "Coleção completa para testar a API de Tarefas na Vercel. Execute o Runner na ordem listada (excluir por último).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://aos-2026-2-psi.vercel.app",
      "type": "string"
    },
    {
      "key": "objectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Criar Tarefa (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('Retorna objectId UUID', function () { pm.expect(json.objectId).to.be.a('string'); });",
              "pm.test('Retorna descricao correta', function () { pm.expect(json.descricao).to.eql('Estudar Express 5 e Sequelize'); });",
              "pm.collectionVariables.set('objectId', json.objectId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Estudar Express 5 e Sequelize\",\n  \"concluida\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "2. Listar Tarefas (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Retorna um array de tarefas', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "3. Buscar Tarefa por ID (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('objectId confere', function () { pm.expect(json.objectId).to.eql(pm.collectionVariables.get('objectId')); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "4. Atualizar Tarefa (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('concluida atualizada para true', function () { pm.expect(json.concluida).to.be.true; });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"concluida\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        }
      }
    },
    {
      "name": "5. ERRO — 400 sem descricao",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 400', function () { pm.response.to.have.status(400); });",
              "pm.test('status é fail', function () { pm.expect(pm.response.json().status).to.eql('fail'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"concluida\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tarefas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas"
          ]
        }
      }
    },
    {
      "name": "6. ERRO — 400 UUID inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 400', function () { pm.response.to.have.status(400); });",
              "pm.test('status é fail', function () { pm.expect(pm.response.json().status).to.eql('fail'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/uuid-invalido-123",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "uuid-invalido-123"
          ]
        }
      }
    },
    {
      "name": "7. ERRO — 404 Tarefa inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 404', function () { pm.response.to.have.status(404); });",
              "pm.test('status é fail', function () { pm.expect(pm.response.json().status).to.eql('fail'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/00000000-0000-0000-0000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "00000000-0000-0000-0000-000000000000"
          ]
        }
      }
    },
    {
      "name": "8. Excluir Tarefa (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code é 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Retorna mensagem de sucesso', function () { pm.expect(pm.response.json().mensagem).to.include('sucesso'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tarefas/{{objectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tarefas",
            "{{objectId}}"
          ]
        }
      }
    }
  ]
}
